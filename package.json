{
  "name": "coding-family-full-stack",
  "version": "1.0.0",
  "description": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "kill-port": "npx kill-port 2001 && npx kill-port 2002",
    "app:install": "yarn install && yarn --cwd ./backend install && yarn --cwd ./frontend install",
    "app:dev": "yarn kill-port && concurrently \"yarn --cwd ./backend dev\" \"yarn --cwd frontend dev\"",
    "app:build": "yarn --cwd ./frontend build && yarn --cwd ./backend build",
    "app:start": "yarn kill-port && yarn --cwd ./backend start",
    "format": "yarn --cwd ./frontend format && yarn --cwd ./backend format"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
